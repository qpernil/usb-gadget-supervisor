[Unit]
Description=USB gadget profile %i
Documentation=https://github.com/qpernil/usb-gadget-supervisor
After=local-fs.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/sbin/usb-gadget-supervisor --profile /etc/usb-gadget-supervisor/profiles/%i.toml
Restart=on-failure
RestartSec=2s
KillMode=mixed
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
